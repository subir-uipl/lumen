---
// A metal paper clip, drawn as two strokes (shadow + steel). Position with `class`.
interface Props { class?: string; rot?: number; size?: number }
const { class: cls = '', rot = 0, size = 64 } = Astro.props;
const id = `clipSteel-${Math.round(Math.random() * 1e6)}`;
const d = 'M9 54 V12 a6.5 6.5 0 0 1 13 0 V50 a10.5 10.5 0 0 1 -21 0 V18';
---
<svg class:list={['pointer-events-none absolute z-[4] overflow-visible', cls]} style={`transform:rotate(${rot}deg)`} width={size * 0.45} height={size * 1.03} viewBox="-2 -1 28 68" fill="none" aria-hidden="true">
  <path d={d} transform="translate(.8 1.2)" stroke="rgba(40,30,10,.25)" stroke-width="2.6" stroke-linecap="round" />
  <path d={d} stroke={`url(#${id})`} stroke-width="2.4" stroke-linecap="round" />
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#d9dde2" /><stop offset=".45" stop-color="#8f969f" /><stop offset="1" stop-color="#c3c8ce" />
    </linearGradient>
  </defs>
</svg>
